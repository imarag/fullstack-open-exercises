{
        "printWidth": 80,
        "tabWidth": 8,
        "useTabs": false,
        "semi": true,
        "singleQuote": true,
        "trailingComma": "es5",
        "bracketSpacing": true,
        "arrowParens": "always",
        "endOfLine": "lf",
        "jsxSingleQuote": false,
        "quoteProps": "as-needed"
}
